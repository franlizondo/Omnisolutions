# Copiar este archivo como ".env" (en la raiz del proyecto) y completar los valores.
# El archivo .env esta excluido de Git: nunca subir credenciales reales.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=omni_solutions
DB_USER=omni_app
DB_PASSWORD=cambiar_esta_contrasena
# always = crea las tablas si no existen al iniciar; never = no ejecuta schema.sql
DB_INIT_MODE=always
SERVER_PORT=8080
